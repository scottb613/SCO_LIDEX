<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SCOLIDEX</AssemblyName>
    <AssemblyTitle>SCO LIDEX Terrain Builder</AssemblyTitle>
    <Product>SCO LIDEX</Product>
    <Authors>Scott Brunner, Beast of Burden</Authors>
    <Company>Beast of Burden</Company>
    <Copyright>Copyright (C) Scott Brunner, Beast of Burden</Copyright>
    <Description>SCO LIDEX Terrain Builder for Open Rails and MSTS routes.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Version>1.401.0</Version>
    <InformationalVersion>1.401.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>1.401.0.0</AssemblyVersion>
    <FileVersion>1.401.0.0</FileVersion>
    <ApplicationIcon>SCOtopo.ico</ApplicationIcon>
    <!-- FIX: Force the compiler to build for 64-bit to match GDAL -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaxRev.Gdal.Universal" Version="3.13.1.534" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Saves\**\*.cs" />
    <Compile Remove="SCO_LIDEX\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="VERSION" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <Content Include="SCOtopo.ico" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <Content Include="content\ScoBull.png" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <Content Include="content\SCO-LIDEX-Header.png" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <Content Include="content\Contact.png" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <Content Include="content\*.wav" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <Content Include="docsMaster\**\*.*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="generated-tiles\**\*.*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="generated-lo_tiles\**\*.*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
